<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System.Configuration.ConfigurationManager" >
            <section name="textEdit.Properties.Settings" type="System.Configuration.ClientSettingsSection, System.Configuration.ConfigurationManager" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
	<appSettings>
		<add key="第N章/回" value="(\s*?)第.{1,7}[章回]" />
		<add key="（N）" value="(\s*?)[（\(].{1,7}[）\)]" />
		<add key="N" value="^(\s*?)\d+" />
	</appSettings>
	
 <userSettings>
  <textEdit.Properties.Settings>
   <setting name="DuanWei" serializeAs="String">
    <value>(.*?)[\.\'\?。？”’！」：…＊）】]$</value>
   </setting>
   <setting name="width" serializeAs="String">
    <value>1224</value>
   </setting>
   <setting name="height" serializeAs="String">
    <value>685</value>
   </setting>
   <setting name="toolsEnabel" serializeAs="String">
    <value>False</value>
   </setting>
  </textEdit.Properties.Settings>
 </userSettings>
</configuration>